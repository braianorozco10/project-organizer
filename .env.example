# --- Database ---------------------------------------------------------------
# Neon Postgres connection string.
# Vercel → your project → Storage → Create Database → Neon. Vercel injects this
# automatically on deploy; copy it here for local development.
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Encrypts the session cookie and the OAuth tokens stored in Postgres.
# Generate one with: openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-random-48-byte-string"

# --- Atlassian OAuth 2.0 (3LO) ----------------------------------------------
# Create an app at https://developer.atlassian.com/console/myapps
#   1. Create → OAuth 2.0 integration
#   2. Permissions → Jira API → add scopes: read:jira-work, read:jira-user
#   3. Authorization → OAuth 2.0 (3LO) → callback URL: <APP_URL>/api/auth/callback
#   4. Settings → copy the client ID and secret
ATLASSIAN_CLIENT_ID=""
ATLASSIAN_CLIENT_SECRET=""

# Public origin of this deployment, no trailing slash. The callback URL is
# derived from it and must match the developer console exactly.
APP_URL="http://localhost:3000"
