# Neon Postgres connection string.
# Vercel → your project → Storage → Create Database → Neon. Vercel injects this
# automatically on deploy; copy it here for local development.
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Encrypts the session cookie holding your Jira credentials.
# Generate one with: openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-random-48-byte-string"
